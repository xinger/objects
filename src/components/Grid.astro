---
import type { createCatalog } from '../lib/catalog.js';

interface Props { objects: ReturnType<typeof createCatalog>['objects']; }
const { objects } = Astro.props;
---
{objects.length ? <div class="object-grid">
  {objects.map((object, index) => <article class="object-tile" style={`--delay:${Math.min(index, 9) * 18}ms`}>
    <a class="object-link" href={object.href} aria-label={object.title}>
      <img src={object.preview} alt={object.title} width={object.width} height={object.height} loading={index < 10 ? 'eager' : 'lazy'} decoding="async" />
      <span class="image-unavailable" hidden>Image unavailable</span>
    </a>
  </article>)}
</div> : <div class="empty-state"><p>No objects yet</p></div>}
