---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getCatalog } from '../lib/data.js';

const catalog = getCatalog();
---
<Layout title="Page not found · Objects" noindex>
  <Header categories={catalog.categories} total={catalog.objects.length} />
  <main id="content" class="empty-state" tabindex="-1"><h1>Page not found</h1><a class="text-link" href="/all/">All objects</a></main>
</Layout>
