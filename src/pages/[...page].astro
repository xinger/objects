---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Grid from '../components/Grid.astro';
import Pagination from '../components/Pagination.astro';
import { getCatalog } from '../lib/data.js';
import { paginate } from '../lib/catalog.js';

export function getStaticPaths() {
  const catalog = getCatalog();
  const pages = paginate(catalog.feed);
  return pages.map((objects, index) => ({ params: { page: index ? `all/page/${index + 1}` : 'all' }, props: { objects, page: index + 1, pages: pages.length } }));
}
const { objects, page, pages } = Astro.props;
const catalog = getCatalog();
---
<Layout title={page === 1 ? 'Objects' : `Objects · ${page}`}>
  <Header categories={catalog.categories} total={catalog.objects.length} />
  <main id="content" tabindex="-1">
    <h1 class="sr-only">All objects</h1>
    <Grid objects={objects} />
    <Pagination page={page} pages={pages} />
  </main>
</Layout>
